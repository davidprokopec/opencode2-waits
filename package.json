{
  "name": "opencode2-waits",
  "version": "0.2.1",
  "description": "OpenCode V2 plugin that defers a prompt: /wait 1hour implement this",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidprokopec/opencode2-waits.git"
  },
  "homepage": "https://github.com/davidprokopec/opencode2-waits#readme",
  "bugs": "https://github.com/davidprokopec/opencode2-waits/issues",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/index.ts",
    "./tui": "./src/tui.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "effect",
    "scheduler",
    "delay"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun test",
    "prepublishOnly": "bun run check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-19242",
    "@opencode-ai/schema": "0.0.0-beta-19242",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "effect": "4.0.0-rc.112",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@opencode-ai/theme": "0.0.0-beta-19242",
    "@opentui/keymap": "0.5.10",
    "@types/bun": "1.3.14",
    "@types/node": "24.12.2",
    "typescript": "5.8.2"
  }
}
